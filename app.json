{
  "expo": {
    "name": "Walkthrough AI",
    "slug": "walkthrough-ai",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "walkthroughai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andrewthomas.walkthroughai",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "Walkthrough AI uses your camera to photograph industrial products during a walkthrough.",
        "NSPhotoLibraryUsageDescription": "Walkthrough AI uses your photo library so you can select industrial product photos for analysis.",
        "NSPhotoLibraryAddUsageDescription": "Walkthrough AI can save generated reports and images to your device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.andrewthomas.walkthroughai",
      "adaptiveIcon": {
        "backgroundColor": "#071426",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a00623c-103d-45b8-9540-1508351d3ad1"
      }
    },
    "owner": "anthomas1028",
    "description": "AI-assisted industrial inventory walkthroughs with photo analysis, review, reporting, and customer history."
  }
}
