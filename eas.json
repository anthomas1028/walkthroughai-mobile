{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "APP_STORE_VERSION": "2.0.1"
      }
    },
    "test": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "testing",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "test"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6796574559"
      }
    }
  }
}
